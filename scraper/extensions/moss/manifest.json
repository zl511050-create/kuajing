{
  "manifest_version": 3,
  "name": "fastmoss",
  "version": "1.0",
  "description": "插件系统",
  "permissions": [
    "proxy",
    "storage",
    "tabs",
    "cookies",
    "activeTab",
    "scripting",
    "webRequest",
    "webRequestAuthProvider",
    "notifications",
    "declarativeNetRequest",
    "webNavigation"
  ],
  "host_permissions": [
    "<all_urls>"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_icon": {
      "16": "icon.png",
      "48": "icon.png",
      "128": "icon.png"
    }
  },
  "icons": {
    "16": "icon.png",
    "48": "icon.png",
    "128": "icon.png"
  }
}
